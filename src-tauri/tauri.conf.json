{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RefMind3D",
  "version": "1.9.0",
  "identifier": "com.refmind3d.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RefMind3D",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "theme": "Dark",
        "backgroundColor": "#242424",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**/*",
          "$APPCACHE/**/*",
          "$LOCALDATA/**/*",
          "$HOME/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "refmind3d",
          "refmind"
        ],
        "name": "RefMind3D Project",
        "description": "RefMind3D Project",
        "role": "Editor"
      }
    ]
  }
}
